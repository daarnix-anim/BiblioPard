<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="11.0" ExtensionBundleId="com.bibliopard.extension" ExtensionBundleVersion="0.0.1"
    ExtensionBundleName="BiblioPard" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <ExtensionList>
        <Extension Id="com.bibliopard.extension.panel" Version="0.0.1" />
    </ExtensionList>
    <ExecutionEnvironment>
        <HostList>
            <!-- After Effects (AE 2022 to 2026.2+) -->
            <Host Name="AEFT" Version="[22.0,99.9]" />
            <!-- Premiere Pro (2022 to 2026+) -->
            <Host Name="PPRO" Version="[22.0,99.9]" />
        </HostList>
        <LocaleList>
            <Locale Code="All" />
        </LocaleList>
        <RequiredRuntimeList>
            <RequiredRuntime Name="CSXS" Version="11.0" />
        </RequiredRuntimeList>
    </ExecutionEnvironment>
    <DispatchInfoList>
        <Extension Id="com.bibliopard.extension.panel">
            <DispatchInfo>
                <Resources>
                    <MainPath>./dist/index.html</MainPath>
                    <ScriptPath>./jsx/host_ae.jsx</ScriptPath>
                    <CEPEngine>
                        <CommandLine>
                            <Parameter>--enable-nodejs</Parameter>
                            <Parameter>--mixed-context</Parameter>
                        </CommandLine>
                    </CEPEngine>
                </Resources>
                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                </Lifecycle>
                <UI>
                    <Type>Panel</Type>
                    <Menu>BiblioPard</Menu>
                    <Geometry>
                        <Size>
                            <Height>700</Height>
                            <Width>550</Width>
                        </Size>
                        <MinSize>
                            <Height>400</Height>
                            <Width>340</Width>
                        </MinSize>
                        <MaxSize>
                            <Height>2400</Height>
                            <Width>2400</Width>
                        </MaxSize>
                    </Geometry>
                    <Icons>
                        <Icon Type="Normal">./public/icon-normal.png</Icon>
                        <Icon Type="RollOver">./public/icon-normal.png</Icon>
                        <Icon Type="DarkNormal">./public/icon-normal.png</Icon>
                        <Icon Type="DarkRollOver">./public/icon-normal.png</Icon>
                    </Icons>
                </UI>
            </DispatchInfo>
        </Extension>
    </DispatchInfoList>
</ExtensionManifest>
